{
  "manifest_version": 3,
  "name": "Flipwatch — Deal Monitor for eBay",
  "short_name": "Flipwatch",
  "version": "1.0.0",
  "description": "Real-time new-listing alerts, auction sniping assistant, deal scores, and a reseller portfolio. Subscription required.",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "host_permissions": ["https://kiynmpyqwjcpsurhgibl.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel/panel.html" },
  "action": {
    "default_title": "Flipwatch",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options/options.html",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
